# Copiez ce fichier en `.env` puis complétez-le.
#   cp .env.example .env
# Le fichier `.env` est ignoré par git : ne commitez jamais de secrets.

# --- LLM : OpenCode Zen (le fournisseur utilisé par opencode) ---
# Clé API du provider "opencode" (OpenCode Zen). Nécessaire pour que les
# agents Strix puissent raisonner. Récupérez-la via `opencode providers login`.
LLM_API_KEY=

# Modèle par défaut (LiteLLM `openai/<id>` + base Zen personnalisée).
STRIX_LLM=openai/big-pickle

# Base URL OpenAI-compatible de Zen (même endpoint que votre opencode).
LLM_API_BASE=https://opencode.ai/zen/v1

# --- Options Strix (optionnelles) ---
# STRIX_REASONING_EFFORT=none|minimal|low|medium|high|xhigh|max
# STRIX_DEDUPE_MODEL=openai/<modele-plus-leger>
# STRIX_WEB_SEARCH_PROVIDER=perplexity|exa
# EXA_API_KEY=
# PERPLEXITY_API_KEY=