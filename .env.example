# Copy this file to `.env` only if you need to override the resolved defaults:
#   cp .env.example .env
# The `.env` file is git-ignored: never commit secrets.
#
# By default, scripts/scan.sh and the Makefile resolve the LLM backend
# (base URL, model, API key) automatically from your live opencode
# configuration. No client-specific value is stored in this repository.

# --- Optional overrides ---
# LLM_API_KEY=                 # override the key resolved from opencode auth.json
# STRIX_LLM=                   # e.g. openai/<model-id>
# LLM_API_BASE=                # e.g. https://example.com/openai/v1

# --- Optional Strix settings ---
# STRIX_REASONING_EFFORT=none|minimal|low|medium|high|xhigh|max
# STRIX_DEDUPE_MODEL=openai/<cheaper-model>
# STRIX_WEB_SEARCH_PROVIDER=perplexity|exa
# EXA_API_KEY=
# PERPLEXITY_API_KEY=